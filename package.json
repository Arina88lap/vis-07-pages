{
  "name": "vis-pages",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://arina88lap.github.io/vis-07-pages/",
  "scripts": {
    "serve": "json-server --watch src/server/db/index.js --routes src/server/routes.json --port 3001 --host 127.0.0.1",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node src/server/scripts/save-json-api.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build --dotfiles"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "gh-pages": "6.3.0",
    "json-server": "0.17.4",
    "typescript": "4.9.5"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
