{
  "name": "vis-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://arina88lap.github.io/vis-07-pages/",
  "scripts": {
    "serve": "json-server --watch public/static/db/data.json --routes server/routes.json --port 3001 --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1 --port 8407 --strictPort",
    "build": "vite build && node -e \"require('node:fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview --host 127.0.0.1 --port 8507 --strictPort",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {"react": "19.2.6", "react-dom": "19.2.6", "react-router-dom": "7.16.0"},
  "devDependencies": {"gh-pages": "6.3.0", "json-server": "0.17.4", "vite": "7.3.3"}
}
